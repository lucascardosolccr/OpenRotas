+def _balsa_extra_admissivel(km_balsa):
+    """Quantos km a mais de rodovia ainda tornam a travessia EVITÁVEL (banda adaptativa §6). PURA."""
+    try:
+        _kb = float(km_balsa)
+    except (TypeError, ValueError):
+        return float(_REL_BANDA_ABS_KM)
+    if not (_kb > 0):
+        return float(_REL_BANDA_ABS_KM)
+    return max(float(_REL_BANDA_ABS_KM), float(_REL_BANDA_X) * _kb)
+
+
+def _rota_sem_balsa_razoavel(km_balsa, km_rodovia):
+    """True quando a rodovia de 'km_rodovia' é uma alternativa RAZOÁVEL à travessia de 'km_balsa' (§6):
+    o acréscimo rodoviário cabe na banda admissível. PURA, defensiva."""
+    try:
+        _kb = float(km_balsa); _kr = float(km_rodovia)
+    except (TypeError, ValueError):
+        return False
+    if not (_kb > 0) or not (_kr > 0):
+        return False
+    return (_kr - _kb) <= _balsa_extra_admissivel(_kb)
+
+
+def _balsa_evitavel_banda(candidatos):
+    """True se, no conjunto de candidatos, existe rota RODOVIÁRIA real e plausível dentro da banda
+    admissível sobre a MELHOR travessia — i.e., a balsa é EVITÁVEL (§7). Candidato = dict com
+    'dist_viaria', 'balsa', 'rota_real' (default True) e 'plausivel' (default True). PURA/defensiva."""
+    try:
+        _b = []
+        for _c in (candidatos or []):
+            if _c.get("balsa") and _c.get("rota_real", True) and not _c.get("_adiavel"):
+                _dv = _num(_c.get("dist_viaria"))
+                if _dv and _dv > 0:
+                    _b.append(float(_dv))
+        _r = []
+        for _c in (candidatos or []):
+            if not _c.get("balsa") and _c.get("rota_real", True) and _c.get("plausivel", True):
+                _dv = _num(_c.get("dist_viaria"))
+                if _dv and _dv > 0:
+                    _r.append(float(_dv))
+        if not _b or not _r:
+            return False
+        _melhor_balsa = min(_b)
+        for _kr in _r:
+            if _kr <= _melhor_balsa + _balsa_extra_admissivel(_melhor_balsa):
+                return True
+        return False
+
