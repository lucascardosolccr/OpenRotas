# ==============================================================================
# EXEMPLO de secrets.toml para o sistema de autenticação — copie este arquivo
# para `.streamlit/secrets.toml` (na raiz do repositório) e preencha com valores
# reais. NUNCA commite o arquivo `.streamlit/secrets.toml` de verdade — ele já
# está no .gitignore.
#
# Em produção (Streamlit Community Cloud): não use este arquivo — cole o mesmo
# conteúdo, com os valores reais, em "Settings → Secrets" do seu app no painel
# do Streamlit Cloud.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — painel do projeto → Project Settings → API
# ------------------------------------------------------------------------------
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY = "sua-chave-anon-publica-aqui"
# NUNCA use a "service_role key" aqui — essa é um segredo de administrador que
# ignora as políticas de segurança (RLS) e não deve rodar num cliente Streamlit.

# ------------------------------------------------------------------------------
# E-mail (já usado pela aplicação para o recurso de tickets de suporte — se você
# já configurou isto, a autenticação reaproveita as MESMAS credenciais).
# Para SMTP customizado do Supabase Auth (e-mails de boas-vindas/recuperação
# com a cara da aplicação), configure estas MESMAS credenciais também no painel
# do Supabase: Project Settings → Auth → SMTP Settings.
# ------------------------------------------------------------------------------
EMAIL_SISTEMA = "seu_email_de_envio@gmail.com"
SENHA_APP = "sua_senha_de_aplicativo_do_gmail"

# ------------------------------------------------------------------------------
# LOGIN SOCIAL (Google / Microsoft) — OPCIONAL
# ------------------------------------------------------------------------------
# APP_URL: a URL pública do app (para onde o provedor devolve o usuário após o
# login). Ex.: "https://seuapp.streamlit.app/". Se ficar em branco, o Supabase usa
# a "Site URL" configurada no painel (Auth → URL Configuration).
APP_URL = "https://SEU-APP.streamlit.app/"
#
# Para os botões "Google"/"Microsoft" funcionarem, habilite os provedores no
# Supabase (Authentication → Providers) — NÃO há segredo aqui no app; os Client
# ID/Secret ficam SÓ no painel do Supabase:
#
#   GOOGLE:
#     1) Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#        (tipo "Web application"). Em "Authorized redirect URIs", cole a URL de
#        callback do Supabase: https://SEU-PROJETO.supabase.co/auth/v1/callback
#     2) Copie Client ID e Client Secret para Supabase → Authentication →
#        Providers → Google (Enable + colar as credenciais).
#
#   MICROSOFT (provider "azure" no Supabase):
#     1) Azure Portal → Microsoft Entra ID → App registrations → New registration.
#        Em "Redirect URI" (Web), cole: https://SEU-PROJETO.supabase.co/auth/v1/callback
#     2) Crie um "Client secret" e copie Application (client) ID + o secret para
#        Supabase → Authentication → Providers → Azure (Enable + colar).
#
#   3) Em Supabase → Authentication → URL Configuration, ponha sua APP_URL em
#      "Site URL" e também em "Redirect URLs" (allow list), senão o retorno é
#      recusado.

# ------------------------------------------------------------------------------
# GEOCODIFICAÇÃO — provedores EXTRAS (opcionais)
# ------------------------------------------------------------------------------
# O reconhecimento de endereços já funciona sem nada aqui (ArcGIS + Nominatim +
# Photon, todos sem chave, além da base oficial do IBGE). Estas chaves ATIVAM
# provedores ADICIONAIS que entram como votos independentes no consenso — quanto
# mais fontes concordam, mais confiável a coordenada, especialmente em endereços
# difíceis/ambíguos. Sem as chaves, nada muda (o app ignora provedores sem chave).
#
#   LocationIQ — crie uma conta grátis em https://locationiq.com (≈5.000/dia) e
#   copie o "Access Token":
# LOCATIONIQ_API_KEY = "seu-token-locationiq"
#
#   Geoapify — crie uma conta grátis em https://www.geoapify.com (≈3.000/dia) e
#   copie a "API Key":
# GEOAPIFY_API_KEY = "sua-chave-geoapify"
