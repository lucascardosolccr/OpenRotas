# OpenRotas Desktop — artefatos de build e segredos (NUNCA versionar)
build/
dist/
dist_installer/
*.exe
*.spec.bak
__pycache__/
*.pyc

# Config real do usuário (contém chaves). O exemplo (desktop.example.json) É versionado.
config/desktop.json

# Ícone gerado em tempo de build (make_icon.py) — não versionar o binário.
installer/openrotas.ico

# Dados locais grandes instalados à parte (grafos/mapas) — não entram no git.
# O CÓDIGO-FONTE da camada data_local (local_data.py / __init__.py) É versionado;
# só os ARTEFATOS de dados grandes dentro de data_local/ ficam de fora.
data_local/*
!data_local/*.py
!data_local/README*
*.osrm
*.osrm.*
*.pbf
