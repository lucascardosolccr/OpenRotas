# =====================================================================================
# OpenRotas — .gitignore
# Segredos, caches operacionais e lixo não entram no repositório.
# As chaves de API são carregadas via st.secrets (.streamlit/secrets.toml) — jamais
# versionadas.
# =====================================================================================

# ---- Segredos (Streamlit Cloud / local) ----
.streamlit/*
!.streamlit/config.toml
secrets.toml
*.env
.env.*

# ---- Caches operacionais (resultados reais de API / caderneta / telemetria) ----
cache_*/
logs_*/
!cache_osm/                 # (registro: nada aqui por ora)
inteligencia_geoespacial/caches/
*.pkl

# ---- Estado interno da ferramenta de automação ----
.superpowers/

# ---- Dados geoespaciais pesados baixados (IBGE BC250/BC100, etc.) ----
data/
# ... porém as camadas leves/resumidas IBGE são versionadas para o deploy no Streamlit Cloud
!data/
data/*
!data/brasil/
data/brasil/*
!data/brasil/ibge/
data/brasil/ibge/*
!data/brasil/ibge/derivadas/
!data/brasil/ibge/derivadas/manifest.json
!data/brasil/ibge/derivadas/*.parquet
# As bases grandes drenagem/rodovias NÃO entram inteiras (excedem 100MB do push comum);
# os .parquet reassemblados são ARTEFATOS (ignorados) — o que entra são os PEDAÇOS <100MB em
# _bigparts/, reassemblados por montar_bases_grandes.py no build/CI. Cobertura nacional completa.
data/brasil/ibge/derivadas/drenagem.parquet
data/brasil/ibge/derivadas/rodovias.parquet
!data/brasil/ibge/derivadas/_bigparts/
!data/brasil/ibge/derivadas/_bigparts/**

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- Sessão / automação ----
.env

# ---- SO / editor ----
Thumbs.db
.DS_Store
.idea/
.vscode/
*.suo
# Config padrão embutida (gerada no CI a partir de secrets; NUNCA commitar — contém chaves)
desktop/config/_config_padrao.ork
